# ── AWS / MinIO Credentials ───────────────────────────────
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_REGION=us-east-1

# ── AWS S3 Endpoint (MinIO) ───────────────────────────────
AWS_S3_ENDPOINT=http://your-minio-host:9000
AWS_ENDPOINT_URL=http://your-minio-host:9000
AWS_S3_ADDRESSING_STYLE=path
AWS_HTTPS=NO
AWS_VIRTUAL_HOSTING=FALSE

# ── imageio-ext S3 Range Reader ───────────────────────────
IIO_S3_AWS_USER=your-minio-access-key
IIO_S3_AWS_PASSWORD=your-minio-secret-key
IIO_S3_AWS_REGION=us-east-1
IIO_S3_AWS_ENDPOINT=http://your-minio-host:9000
IIO_S3_AWS_CORE_POOL_SIZE=100
IIO_S3_AWS_MAX_POOL_SIZE=256
IIO_S3_AWS_KEEP_ALIVE_TIME=30

# ── GeoServer S3 Plugin ───────────────────────────────────
S3_ENDPOINT=http://your-minio-host:9000
S3_ALIAS=minio
S3_USER=your-minio-access-key
S3_PASS=your-minio-secret-key

# ── GeoServer Extensions ──────────────────────────────────
COMMUNITY_EXTENSIONS=cog-s3
STABLE_EXTENSIONS=wps,csw,gwc-s3,monitor
INSTALL_EXTENSIONS=true

# ── GeoServer General ─────────────────────────────────────
GEOSERVER_VERSION=2.28.2
EXTRA_JAVA_OPTS=-Xms1G -Xmx2G

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=geoserver
POSTGRES_USERNAME=geoserver
POSTGRES_PASSWORD=geoserver
POSTGRES_JNDI_ENABLED=true
POSTGRES_JNDI_RESOURCE_NAME=jdbc/postgres

# ── CORS ──────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,HEAD,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Accept,X-Requested-With,Content-Type,Access-Control-Request-Method,Access-Control-Request-Headers
CORS_ALLOW_CREDENTIALS=false

# ── Misc ──────────────────────────────────────────────────
PROXY_BASE_URL=
JSONP_ENABLED=false
ROOT_WEBAPP_REDIRECT=false
SKIP_DEMO_DATA=false
RUN_UNPRIVILEGED=true
RUN_WITH_USER_UID=1000
RUN_WITH_USER_GID=1000